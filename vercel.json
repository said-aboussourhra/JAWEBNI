{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{node_modules/**,tests/**,docs/**,sandbox-tools/**,docker/**,database/*.sqlite,storage/logs/*,storage/framework/*/*,.env,.git/**,.github/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:c6YW+woES+8Wa3ryslZeaDDVTHBJI75AeoFbnaconMU=",
    "APP_URL": "https://jawebni.vercel.app",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "SESSION_DRIVER": "cookie",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "lax",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "local",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/jawebni/database/database.sqlite",
    "AI_PROVIDER": "openai",
    "VIEW_COMPILED_PATH": "/tmp/views"
  }
}
